# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon: one branch per developer, e.g. dev-ui / dev-admin)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sessions – REQUIRED in production. A long random value, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Admin sign-in – there are no built-in defaults; admin login stays off until these are set.
ADMIN_EMAILS=""                 # comma-separated admin emails, e.g. "owner@wmart.co.in,staff@wmart.co.in"
# Recommended: store only a hash of the admin password. Create it with:
#   npx tsx scripts/hash-admin-password.ts "<your long admin password>"
# and paste the printed line here exactly as printed. Each "$" must stay written as "\$":
# Next.js reads "$name" in .env as a variable – even inside quotes – and would cut the hash short.
ADMIN_PASSWORD_HASH=
# Or the password itself (at least 12 characters in production). Ignored when ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=""

# Payments (later) – PayU only. Use PayU TEST credentials during development.
PAYU_MERCHANT_KEY=""
PAYU_SALT=""
PAYU_BASE_URL="https://test.payu.in"

# Shipping (later) – Delhivery only
DELHIVERY_API_TOKEN=""
DELHIVERY_BASE_URL="https://staging-express.delhivery.com"
DELHIVERY_PICKUP_LOCATION=""

# Images (later)
CLOUDINARY_URL=""

# GST invoices
SELLER_GSTIN=""                 # 15-character GSTIN printed on every tax invoice (required for valid invoices)
SELLER_LEGAL_NAME=""            # optional; defaults to "Worldmart Infocom" (src/lib/site.ts)
INVOICE_PREFIX="WM"             # invoice numbers look like WM/2026-27/0001 and restart every 1 April

# Stock alerts
LOW_STOCK_THRESHOLD="5"         # active products with 1..N units left count as "low stock"
