# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon: one branch per developer, e.g. dev-ui / dev-admin)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin auth (later)
AUTH_SECRET=""
ADMIN_EMAILS="admin@example.com"

# Payments (later) – PayU only. Use PayU TEST credentials during development.
PAYU_MERCHANT_KEY=""
PAYU_SALT=""
PAYU_BASE_URL="https://test.payu.in"

# Shipping (later) – Delhivery only
DELHIVERY_API_TOKEN=""
DELHIVERY_BASE_URL="https://staging-express.delhivery.com"
DELHIVERY_PICKUP_LOCATION=""

# Images (later)
CLOUDINARY_URL=""

# GST invoices
SELLER_GSTIN=""                 # 15-character GSTIN printed on every tax invoice (required for valid invoices)
SELLER_LEGAL_NAME=""            # optional; defaults to "Worldmart Infocom" (src/lib/site.ts)
INVOICE_PREFIX="WM"             # invoice numbers look like WM/2026-27/0001 and restart every 1 April

# Stock alerts
LOW_STOCK_THRESHOLD="5"         # active products with 1..N units left count as "low stock"
