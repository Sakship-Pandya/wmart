# Payments (later) – use Razorpay TEST keys during development
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Shipping (later)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# Images (later)
CLOUDINARY_URL=""
